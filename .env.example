# Copy to .env and adjust as needed.
# Never commit real secrets; use this file as a template only.

# Postgres (also used by docker-compose)
POSTGRES_USER=retryguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retryguard
POSTGRES_PORT=5432

# App connection string (must match the Postgres vars above)
DATABASE_URL=postgresql://retryguard:change-me@localhost:5432/retryguard

# DocuSign client - mock mode talks to a local stub
DOCUSIGN_MODE=mock
DOCUSIGN_BASE_URL=http://localhost:4000
DOCUSIGN_ACCOUNT_ID=demo-account

# Real mode (DOCUSIGN_MODE=real) - JWT Grant against DocuSign demo
# DOCUSIGN_BASE_URL=https://demo.docusign.net
# DOCUSIGN_OAUTH_HOST=account-d.docusign.com
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY_PATH=./secrets/docusign-private.key

# Mock DocuSign server (npm run mock:start)
MOCK_DOCUSIGN_PORT=4000
# 0-1: 500 before create; 0-1: save then 10s + 504 (lost response)
MOCK_FAIL_RATE=0
MOCK_TIMEOUT_RATE=0

# Worker demo: crash once after DocuSign create, before DB save (data/crashed.flag)
# CRASH_AFTER_CREATE=1
# Lock TTL seconds before requeue (demo:crash uses 10)
# WORKER_STALE_SECONDS=60

# Dashboard (npm run dashboard)
# DASHBOARD_PORT=3000

